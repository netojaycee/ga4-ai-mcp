PUBLIC_BASE_URL=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON like {"1":"<base64 of 32 random bytes>"}
TOKEN_ENC_KEYS=
TOKEN_ENC_CURRENT=1
# At least 32 characters
SESSION_SECRET=
# Comma separated
ADMIN_EMAILS=
RESEND_API_KEY=
# e.g. Name <hello@mail.example.com>
MAIL_FROM=
SUPPORT_EMAIL=
BRAND_NAME=
TRIAL_DAYS=14
# Optional, at least 16 characters. Vercel Cron sends it as "Authorization: Bearer <value>";
# the trial-notice cron refuses to run when it is unset.
# CRON_SECRET=
# Local testing only: lets requests with an `x-dev-user-id` header skip OAuth in non-production. Never set in production.
# ALLOW_DEV_AUTH=1
